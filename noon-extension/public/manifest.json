{
  "manifest_version": 3,
  "name": "Noon Automation",
  "version": "0.1.0",
  "description": "Automate Noon.com login and workflows from a side panel.",
  "permissions": ["storage", "tabs", "sidePanel"],
  "host_permissions": ["https://www.noon.com/*", "https://account.noon.com/*"],
  "action": {
    "default_title": "Noon Automation — open side panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.noon.com/*", "https://account.noon.com/*"],
      "js": ["mouse.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
